# Secret "Pepper" for hashing voter identity (IP + User-Agent).
# Use a long random value in production.
FEEDBACK_VOTE_PEPPER=please-change-this-to-a-long-random-secret

# Public results toggle:
# - false: results stay private, already-voted users are not redirected
# - true: results route becomes available and already-voted users are redirected
FEEDBACK_RESULTS_ENABLED=false

# Path to your public results page (used only when FEEDBACK_RESULTS_ENABLED=true)
FEEDBACK_RESULTS_PATH=/auswertung

# Testing helper:
# - true: user can delete own vote via UI/API for repeated test runs
# - false: delete/reset endpoint is disabled
FEEDBACK_ALLOW_SELF_DELETE=false
